{
  "name": "ooxml-pages",
  "version": "0.4.0",
  "description": "Render Word (.docx) and PowerPoint (.pptx) files in the browser as real pages and slides: Word-like pagination, floating objects, shapes, charts. Small, fast, view-only, no server.",
  "license": "MIT",
  "author": "Kai Jungsthoefel",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./docx": {
      "types": "./dist/docx.d.ts",
      "default": "./dist/docx.js"
    },
    "./pptx": {
      "types": "./dist/pptx.d.ts",
      "default": "./dist/pptx.js"
    },
    "./metafile": {
      "types": "./dist/metafile.d.ts",
      "default": "./dist/metafile.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./docx.css": "./dist/docx.css",
    "./pptx.css": "./dist/pptx.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kai-Jungsthoefel/ooxml-pages.git"
  },
  "homepage": "https://github.com/Kai-Jungsthoefel/ooxml-pages#readme",
  "bugs": "https://github.com/Kai-Jungsthoefel/ooxml-pages/issues",
  "keywords": [
    "docx",
    "pptx",
    "ooxml",
    "office-open-xml",
    "word",
    "powerpoint",
    "viewer",
    "renderer",
    "preview",
    "pagination",
    "browser"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "samples": "node scripts/generate-docx-samples.mjs && node scripts/generate-pptx-samples.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.24.0"
  },
  "peerDependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1"
  },
  "peerDependenciesMeta": {
    "@cantoo/fontkit": {
      "optional": true
    },
    "@cantoo/pdf-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@fontsource/noto-sans-symbols": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "html-entities": "^2.6.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
